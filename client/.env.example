# Expo reads .env from the PROJECT root (this directory), not the repo root.
# The repo-root .env configures the Go server and is NOT visible to the client.
# Copy this file to client/.env before running the app.
#
# Only EXPO_PUBLIC_* variables are exposed to app code. They are inlined at
# BUILD time, so restart Metro after changing them (pnpm run web --clear).

# Full WebSocket URL of the Indri server, including the /ws path.
# Must match INDRI_LISTEN_ADDRESS/INDRI_LISTEN_PORT in the repo-root .env.
#
#   web + iOS simulator : ws://localhost:5004/ws
#   Android emulator    : ws://10.0.2.2:5004/ws   (localhost is the emulator itself)
#   physical device     : ws://<your-LAN-IP>:5004/ws
EXPO_PUBLIC_API_URL="ws://localhost:5004/ws"
