# Expo reads .env from the PROJECT root (this directory), not the repo root.
# The repo-root .env configures the Go server and is NOT visible to the client.
# Copy this file to client/.env before running the app.
#
# Only EXPO_PUBLIC_* variables are exposed to app code. They are inlined at
# BUILD time, so restart Metro after changing them (pnpm run web --clear).

# Which transport to connect with; the server must list it in INDRI_TRANSPORTS.
#   ws (default) | sse | graphqlws | webrtc
# webrtc works on web; on iOS/Android it needs react-native-webrtc in a
# development build (not Expo Go).
EXPO_PUBLIC_TRANSPORT="ws"

# The server endpoint for that transport.
# Must match INDRI_LISTEN_ADDRESS/INDRI_LISTEN_PORT in the repo-root .env.
#
#   ws        : ws://localhost:5004/ws
#   graphqlws : ws://localhost:5004/graphql
#   sse       : http://localhost:5004
#   webrtc    : http://localhost:5004
#
# Replace localhost with 10.0.2.2 on the Android emulator (localhost is the
# emulator itself) or with your LAN IP on a physical device.
EXPO_PUBLIC_API_URL="ws://localhost:5004/ws"
