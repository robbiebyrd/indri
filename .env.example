INDRI_LISTEN_ADDRESS="localhost" # The address the HTTP server should listen on.
INDRI_LISTEN_PORT="5002" # The port the HTTP server should listen on.
INDRI_ALLOWED_ORIGINS="" # Comma-separated browser Origins allowed to connect over any transport. Empty rejects all cross-origin browsers; clients sending no Origin header, or their target's own origin (as React Native's iOS WebSocket does), are always allowed.
INDRI_TRANSPORTS="ws" # Comma-separated client transports to serve concurrently: ws (/ws), sse (/sse/stream + /sse/send), graphqlws (/graphql), webrtc (/webrtc/offer). SSE and WebRTC need sticky sessions (IP hash) behind a load balancer.
INDRI_MONGO_PORT="27017" # Host port to publish the MongoDB container on (docker-compose).
INDRI_REDIS_HOST="localhost" # The address of the Redis server.
INDRI_REDIS_PORT="6379"  # The port of the Redis server.
INDRI_REDIS_PASSWORD=""  # The password of the Redis server.
INDRI_REDIS_EMPTY_PASSWORD="yes"  # Whether or not Redis should allow an Empty Password.
INDRI_REDIS_DATABASE="0" # The Redis database to use.
INDRI_LOCK_BACKEND="inprocess" # Coordination backend: "inprocess" (single instance) or "redis" (multi-instance). "redis" serializes record edits across processes AND fans real-time change events out to all instances via Pub/Sub.
INDRI_MONGO_URI="mongodb+srv://test:test@localhost/" # The URI to connect to the MongoDB databse.
INDRI_MONGO_DATABASE="indri" # The MongoDB database to use.
INDRI_MONGO_AUTH_DATABASE="admin" # The MongoDB database to use when looking up credentials.
INDRI_WS_WRITE_TIMEOUT=10 # The duration, in seconds, before a write to a Websocket channel times out.
INDRI_WS_PING_PERIOD=54 # The interval, in seconds, when PING requests are sent to the client. Also the SSE keepalive and graphqlws ping interval.
INDRI_WS_PONG_TIMEOUT=60 # If a PONG isn't received within the interval, in seconds, the Websocket channel times out. Also applies to graphqlws.
INDRI_WS_MAX_MESSAGE_SIZE=32768 # The max size of client messages, in bytes, on every transport.
INDRI_WS_MESSAGE_BUFFER_SIZE=1024 # Outbound messages queued per connection, on every transport; can increase memory.
INDRI_WEBRTC_ICE_SERVERS="" # Comma-separated STUN/TURN URLs for the webrtc transport. Not needed when the server has a public IP.
INDRI_WEBRTC_MAX_PEERS=256 # Cap on concurrent WebRTC peer connections (each holds UDP sockets and DTLS state).
INDRI_WEBRTC_NAT_1TO1_IPS="" # Comma-separated public IPs to advertise when the server sits behind 1:1 NAT (Docker, cloud VMs).
INDRI_WEBRTC_UDP_PORT_MIN=0 # Restrict WebRTC to a UDP port range (for firewalls / Docker port publishing). 0 means any.
INDRI_WEBRTC_UDP_PORT_MAX=0
