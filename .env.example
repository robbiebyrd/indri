INDRI_LISTEN_ADDRESS="localhost" # The address the HTTP server should listen on.
INDRI_LISTEN_PORT="5002" # The port the HTTP server should listen on.
INDRI_ALLOWED_ORIGINS="" # Comma-separated browser Origins allowed to open a WebSocket, matched as exact strings — "http://localhost:8081" does not cover "http://127.0.0.1:8081" or a different port. Empty rejects all cross-origin browsers; non-browser clients (no Origin header) are always allowed.
INDRI_MONGO_PORT="27017" # Host port to publish the MongoDB container on (docker-compose).
INDRI_POSTGRES_USER="indri" # Username for the docker-compose PostgreSQL container. Only the local dev stack reads this; the server itself connects with the URI below.
INDRI_POSTGRES_PASSWORD="indri" # Password for the docker-compose PostgreSQL container. Local development only — do not reuse this compose file for a deployment.
INDRI_POSTGRES_DB="indri" # Database created in the docker-compose PostgreSQL container.
INDRI_POSTGRES_PORT="5432" # Host port to publish the PostgreSQL container on (docker-compose --profile postgres).
INDRI_REDIS_HOST="localhost" # The address of the Redis server.
INDRI_REDIS_PORT="6379"  # The port of the Redis server.
INDRI_REDIS_PASSWORD=""  # The password of the Redis server.
INDRI_REDIS_DATABASE="0" # The Redis database to use.
INDRI_LOCK_BACKEND="inprocess" # Coordination backend: "inprocess" (single instance) or "redis" (multi-instance). "redis" serializes record edits across processes AND fans real-time change events out to all instances via Pub/Sub.
INDRI_MONGO_URI="mongodb+srv://test:test@localhost/" # The URI to connect to the MongoDB databse.
INDRI_MONGO_DATABASE="indri" # The MongoDB database to use.
INDRI_MONGO_AUTH_DATABASE="admin" # The MongoDB database to use when looking up credentials.
INDRI_WS_WRITE_TIMEOUT=10 # The duration, in seconds, before a write to a Websocket channel times out.
INDRI_WS_PING_PERIOD=54 # The interval, in seconds, when PING requests are sent to the client.
INDRI_WS_PONG_TIMEOUT=60 # If a PONG isn't received within the interval, in seconds, the Websocket channel times out.
INDRI_WS_MAX_MESSAGE_SIZE=32768 # The max size of websocket messages that can be sent and received, in bytes.
INDRI_WS_MESSAGE_BUFFER_SIZE=1024 # The total number of messages to store in a buffer; can increase memory.
INDRI_RTC_UDP_PORT=8443 # The single UDP port the WebRTC ICE mux binds for every peer. This port MUST also be published in docker-compose.yml (and any deployment) or ICE fails silently: the signalling POST still succeeds and returns a normal-looking SDP answer, but the DataChannel never reaches "open", with nothing wrong at the HTTP layer to point at why. The port is bound at boot and is fixed, so two instances on one machine collide with "creating udp mux on port 8443: bind: address already in use" — a message that names webrtc and reads like a transport bug but is environmental. Running a second instance locally needs both this and INDRI_LISTEN_PORT set.
INDRI_RTC_NAT_1TO1_IPS="" # Comma-separated IPs advertised as WebRTC host candidates in place of the machine's private address, so a container behind a 1:1 NAT (a docker port mapping, an AWS EIP) is reachable at its actually-routable address. Empty disables the rewrite.
INDRI_RTC_MAX_PEERS=1000 # The maximum number of concurrent WebRTC PeerConnections (pending or connected). Anonymous signalling allocates an ICE agent and a mux registration per request, so this caps that resource-exhaustion vector; once reached, signalling returns 503 instead of allocating.
INDRI_RTC_PENDING_TTL=30 # The duration, in seconds, a WebRTC peer may sit without reaching "connected" before it is closed and dropped.
